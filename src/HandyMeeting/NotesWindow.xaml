<Window x:Class="HandyMeeting.NotesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="HandyMeeting · Nachbearbeitung" Width="1240" Height="940" MinWidth="1000" MinHeight="800" WindowStartupLocation="CenterOwner" Closing="WindowClosing">
  <Window.Resources>
    <Style x:Key="NotesList" TargetType="ItemsControl"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ItemsControl"><Grid><ItemsPresenter/><TextBlock x:Name="Empty" Text="Keine belegten Einträge in dieser Fassung." Foreground="{DynamicResource Muted}" Margin="0,12" Visibility="Collapsed"/></Grid><ControlTemplate.Triggers><Trigger Property="HasItems" Value="False"><Setter TargetName="Empty" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <DataTemplate x:Key="FactTemplate">
      <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,12">
        <StackPanel>
          <TextBlock Text="{Binding Text}" FontSize="15"/>
          <TextBlock Text="{Binding Metadata}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,5,0,0"/>
          <ItemsControl ItemsSource="{Binding Evidence}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" ToolTip="{Binding Evidence.Quote}" Click="ShowEvidence" Padding="7,4" Margin="0,8,8,0" FontSize="12"/></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Grid Margin="24,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,12">
      <TextBlock Text="Nachbearbeitung mit Originalbelegen" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock x:Name="MeetingTitle" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>
    </StackPanel>
    <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
      <StackPanel>
        <Grid x:Name="ConnectionPanel">
          <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="VERARBEITUNG" Style="{StaticResource Label}" Margin="0,0,0,5"/><TextBlock Grid.Column="2" Text="API-ADRESSE" Style="{StaticResource Label}" Margin="0,0,0,5"/><TextBlock Grid.Column="4" Text="API-SCHLÜSSEL · OPTIONAL LOKAL" Style="{StaticResource Label}" Margin="0,0,0,5"/>
          <ComboBox x:Name="ModeCombo" Grid.Row="1" SelectedIndex="0" SelectionChanged="ModeChanged"><ComboBoxItem Content="Lokal · Standard"/><ComboBoxItem Content="Cloud · nur Text"/></ComboBox>
          <TextBox x:Name="EndpointInput" Grid.Row="1" Grid.Column="2" TextChanged="ConnectionChanged"/>
          <PasswordBox x:Name="ApiKeyInput" Grid.Row="1" Grid.Column="4" Padding="8" PasswordChanged="KeyChanged"/>
          <TextBlock Grid.Row="2" Text="TEXTMODELL" Style="{StaticResource Label}"/>
          <DockPanel Grid.Row="2" Grid.Column="2" Margin="0,10,0,0"><Button x:Name="ModelsButton" Content="Modelle prüfen" DockPanel.Dock="Right" Click="CheckModels" Margin="8,0,0,0"/><ComboBox x:Name="ModelInput" IsEditable="True" SelectionChanged="ModelChanged" KeyUp="ModelTyped"/></DockPanel>
          <TextBlock Grid.Row="2" Grid.Column="4" Text="Lokal z. B. LM Studio oder Ollama. Das Textmodell wird getrennt vom Handy-Sprachmodell ausgewählt." FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,12,0,0"/>
        </Grid>
        <TextBlock x:Name="PrivacyText" Margin="0,12,0,0" FontSize="12" Foreground="{DynamicResource Muted}"/>
        <CheckBox x:Name="CloudConsent" Content="Ich erlaube für diese Auswertung die Übertragung des Transkripttexts an den gewählten Cloud-Anbieter. Es können Kosten entstehen." Margin="0,10,0,0" Visibility="Collapsed" Checked="ConsentChanged" Unchecked="ConsentChanged"/>
        <DockPanel x:Name="TemplatePanel" Margin="0,12,0,0">
          <TextBlock Text="Vorlage" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold"/>
          <Button Content="Neue Vorlage" ToolTip="Legt eine benannte Vorlage mit drei anpassbaren Startschritten an." DockPanel.Dock="Right" Click="NewTemplate"/>
          <Button Content="Duplizieren" ToolTip="Kopiert die aktuellen Tabs und Prompts in eine eigene Vorlage." DockPanel.Dock="Right" Click="DuplicateTemplate"/>
          <Button Content="Umbenennen" ToolTip="Ändert den Vorlagennamen. Gespeicherte Auswertungen behalten ihren ursprünglichen Stand." DockPanel.Dock="Right" Click="RenameTemplate"/>
          <Button Content="Entfernen" ToolTip="Entfernt diese Vorlage aus der Auswahl. Gespeicherte Auswertungen werden erhalten." DockPanel.Dock="Right" Click="RemoveTemplate"/>
          <ComboBox x:Name="TemplatesCombo" MinWidth="170" SelectionChanged="TemplateChanged"/>
        </DockPanel>
        <WrapPanel Margin="0,12,0,0"><Button x:Name="GenerateButton" Content="Neue Auswertung erstellen" Background="#1C6249" Foreground="White" Click="Generate"/><Button x:Name="ResumeButton" Content="Gesicherten Stand fortsetzen" IsEnabled="False" Click="Resume"/><Button x:Name="CancelButton" Content="Pausieren und sichern" Visibility="Collapsed" Click="Cancel"/></WrapPanel>
        <TextBlock x:Name="ProgressText" Margin="0,8,0,0" Foreground="{DynamicResource Muted}" FontSize="12" Text="Originaltranskript bleibt unverändert. Jede Auswertung wird als eigene Fassung gespeichert."/>
      </StackPanel>
    </Border>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Gespeicherte Auswertungen" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <ComboBox x:Name="VersionsCombo" Grid.Row="1" SelectionChanged="VersionChanged" Margin="0,0,0,8"/>
        <TabControl x:Name="ResultTabs" Grid.Row="2" Background="{DynamicResource Surface}" Padding="12">
          <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,4"><Button x:Name="AddStepButton" Content="+" Click="AddStep" ToolTip="Eigenen Verarbeitungsschritt hinzufügen" DockPanel.Dock="Right" Padding="12,5" Margin="6,0,0,0"/>
              <Button x:Name="EditStepButton" Content="{DynamicResource EditStepLabel}" Click="EditSelectedStep" ToolTip="{DynamicResource EditStepTip}" DockPanel.Dock="Right" Padding="9,5" Margin="6,0,0,0"/>
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False"><StackPanel Orientation="Horizontal" IsItemsHost="True"/></ScrollViewer>
            </DockPanel>
            <Border Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="SelectedContent"/></Border>
          </Grid></ControlTemplate></TabControl.Template>
        </TabControl>
      </Grid>
      <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="14">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="Originalstelle" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock x:Name="SourceHeading" Grid.Row="1" Text="Einen Quellenverweis links auswählen." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,10"/>
          <TextBox x:Name="SourceText" Grid.Row="2" IsReadOnly="True" IsUndoEnabled="False" IsInactiveSelectionHighlightEnabled="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" BorderThickness="0" Text="Die Originalstelle erscheint hier. Das belegte Zitat wird hervorgehoben. Zeitangaben beziehen sich auf Aufnahmeabschnitte, nicht auf einzelne Wörter."/>
        </Grid>
      </Border>
    </Grid>
    <DockPanel Grid.Row="3" Margin="0,12,0,0">
      <WrapPanel DockPanel.Dock="Right"><Button x:Name="CopyButton" Content="Ergebnisse kopieren" Click="CopyNotes" IsEnabled="False"/><Button x:Name="FolderButton" Content="Ergebnisordner öffnen" Click="OpenResultFolder" IsEnabled="False"/></WrapPanel>
      <TextBlock Text="KI-Entwurf · Quellenkennungen und wörtliche Zitate technisch geprüft. Inhaltliche Deutung bitte prüfen." Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
    </DockPanel>
  </Grid>
</Window>
